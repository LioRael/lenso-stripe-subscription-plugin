{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["effect_id", "resolution", "stripe_object_id", "url", "expires_at", "failure_code"],
  "properties": {
    "effect_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "resolution": {"type": "string", "enum": ["accepted", "known_failure"]},
    "stripe_object_id": {"$ref": "#/$defs/NullableString"},
    "url": {"$ref": "#/$defs/NullableString", "x-lenso-sensitive": true},
    "expires_at": {"$ref": "#/$defs/NullableTimestamp"},
    "failure_code": {"$ref": "#/$defs/NullableString"}
  },
  "additionalProperties": false,
  "$defs": {
    "NullableString": {"type": ["string", "null"]},
    "NullableTimestamp": {"type": ["string", "null"], "format": "date-time"}
  },
  "title": "ResolveUnknownEffectRequest"
}

